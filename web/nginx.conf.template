server {
    listen __LISTEN_PORT__;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve API host so redeploys do not leave a stale upstream IP.
    resolver __NGINX_RESOLVER__ valid=10s ipv6=on;
    resolver_timeout 5s;

    location /healthz {
        set $api_upstream "http://__API_UPSTREAM__";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
    }

    location /readyz {
        set $api_upstream "http://__API_UPSTREAM__";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
    }

    location /v1/ {
        set $api_upstream "http://__API_UPSTREAM__";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
    }

    location / {
        try_files $uri /index.html;
    }
}
