# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Bake commit into the SPA. Railway sets RAILWAY_GIT_COMMIT_SHA on GitHub builds;
# override with --build-arg VITE_GIT_SHA=… locally if needed.
ARG VITE_GIT_SHA=
ARG RAILWAY_GIT_COMMIT_SHA=
ENV VITE_API_BASE=
RUN SHA="${VITE_GIT_SHA:-$RAILWAY_GIT_COMMIT_SHA}"; \
    VITE_GIT_SHA="$SHA" npm run build

FROM nginx:1.27-alpine
# Template + entrypoint so Railway can set PORT and API_UPSTREAM.
COPY web/nginx.conf.template /etc/nginx/nginx.conf.template
COPY web/docker-entrypoint.sh /docker-entrypoint-kyc.sh
RUN chmod +x /docker-entrypoint-kyc.sh
COPY --from=build /src/dist /usr/share/nginx/html
ENV API_UPSTREAM=api:8080
EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
  CMD wget -qO- http://127.0.0.1:${PORT:-80}/ >/dev/null || exit 1
ENTRYPOINT ["/docker-entrypoint-kyc.sh"]
