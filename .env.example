# Copy to .env and fill in values. Never commit .env.
# Docker Compose reads these via ${VAR}; `go run` / local shells may need `export` or `set -a; source .env`.

# --- Required (API / worker) ---
DATABASE_URL=postgres://kyc:kyc@localhost:5432/kyc?sslmode=disable
# Optional second DB for activity + usage meters (noop if unset)
OBSERVABILITY_DATABASE_URL=postgres://kyc:kyc@localhost:5433/kyc_obs?sslmode=disable

# --- HTTP / CORS ---
# HTTP_ADDR=:8080
# PORT=8080
CORS_ORIGIN=http://localhost:8080
APP_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=data/uploads

# --- Auth (operators) ---
# Local/tests: enable dev login and skip Google. Never true in production.
AUTH_DEV_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
OAUTH_STATE_SECRET=change-me-oauth-state

# Optional platform/service tokens (CSV) and emails granted platform_admin on login
API_TOKENS=dev-local-token
PLATFORM_ADMIN_EMAILS=

# Rate limits (0 disables)
CHECK_RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=20

# --- Payments (noop | stripe) ---
PAYMENTS_PROVIDER=noop
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Email (noop | resend) ---
EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=KYC <mail@yourdomain.com>

# --- Web container only (Docker / Railway) ---
# API_UPSTREAM=api:8080
